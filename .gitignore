# Arcade Video Scanner - Git Ignore

# User Data (CRITICAL - DO NOT UPLOAD)
# This directory contains your local thumbnails, previews, and video cache
arcade_data/

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.env

# macOS system files
.DS_Store

# Logs
*.log
server_log.txt
status.txt

# Debug/Development files (ad-hoc scripts, NOT the tests/ suite)
debug_*.py
check_*.py
verify_*.py
# Note: tests/test_*.py are intentionally tracked — see tests/ directory

# Temporary files
*.tmp
*.bak
*.swp
*~

# IDE
.idea/
.vscode/
*.code-workspace

# Scripts (Local paths)
*.sh
*.zip
!run.sh
# Finder-Wrapper: keine lokalen Pfade mehr drin, sie loesen den
# videocrunch-Pfad zur Laufzeit ueber VIDEOCRUNCH_PATH auf. Ungetrackt
# gingen ihre Reparaturen bei jedem frischen Checkout verloren.
!scripts/optimize-from-finder.sh
!scripts/scan-folder-from-finder.sh
!scripts/install-finder-action.sh

# Generated HTML report (user-specific)
video_dashboard.html
*.egg-info/

# macOS AppleDouble / sync artifacts
._*
.DS_Store

# Local runtime / backup junk
screenlog.0
backups/
docker-compose.yml_back*

# Local docker compose overrides (user-specific paths, never commit)
docker-compose.override.yml
